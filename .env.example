# === BACKEND (Bun + Hono, Docker na 192.168.1.11:2363 -> yeapi.wpme.pl) ===
# Skopiuj do .env: cp .env.example .env

PORT=2363

# NFZ API (publiczne, bez klucza)
NFZ_BASE=https://apinfz.nfz.gov.pl/app-itl-api-pcus

# --- Infrastruktura (adresy wewnętrzne docker-compose; lokalnie można pominąć) ---
REDIS_URL=redis://redis:6379
MEILI_URL=http://meilisearch:7700
# Klucz API Meilisearch (ustaw ten sam w docker-compose.yml / env)
MEILI_MASTER_KEY=zdrowapolska-meili-key
# Trwała baza SQLite
DB_PATH=/app/data/zdrowapolska.sqlite

# --- Synchronizacja (kulturalny scraper NFZ: 1 żądanie naraz, odstęp ~60 ms) ---
SNAPSHOT_TTL_H=24        # po tylu godzinach snapshot kolejki jest odświeżany przy zapytaniu
SYNC_INTERVAL_H=12       # cykl harmonogramu w tle
SYNC_PAGES=1             # strony kolejek na województwo przy synchronizacji
SYNC_MAX_QUEUES_PER_RUN=40
SYNC_POPULAR=ODDZIAŁ KARDIOLOGICZNY,ODDZIAŁ CHIRURGII URAZOWO-ORTOPEDYCZNEJ,ODDZIAŁ OKULISTYCZNY,PORADNIA STOMATOLOGICZNA

# --- Doradca AI (wystarczy jeden klucz; bez kluczy działa tryb lokalny) ---
AI_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Ograniczenie CORS (przecinkami); * = otwarte dla wszystkich (OK na hackathon)
CORS_ORIGIN=*
