// Frontend: statyczny SPA na Cloudflare Workers (assets-only, bez skryptu Workera).
// Deploy: `bun run deploy` (vite build + wrangler deploy)
// Domena: podpinasz własną w dashboardzie Cloudflare (Workers -> Domains).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zdrowapolska",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
